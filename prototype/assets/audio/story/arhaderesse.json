  "sentences": [
    {
      "i": 0,
      "t": 0.1,
      "dur": 1.046,
      "cue": "0.00-0.15 усадьба, лучи из-за крыши",
      "text": "Архадерессе."
    },
    {
      "i": 1,
      "t": 2.074,
      "dur": 3.818,
      "cue": null,
      "text": "По-тюркски — спина оврагов."
    },
    {
      "i": 2,
      "t": 5.892,
      "dur": 4.375,
      "cue": null,
      "text": "Есть и другое чтение: старинные подвалы в оврагах."
    },
    {
      "i": 3,
      "t": 10.267,
      "dur": 4.037,
      "cue": null,
      "text": "Оба про одно — про землю, сложенную складками."
    },
    {
      "i": 4,
      "t": 14.954,
      "dur": 5.598,
      "cue": "0.15-0.35 телега идёт по дороге вглубь",
      "text": "Князь Горчаков купил это имение заочно, в Петербурге, за сто тысяч рублей."
    },
    {
      "i": 5,
      "t": 21.507,
      "dur": 5.251,
      "cue": null,
      "text": "И одиннадцать лет исправно слал деньги, ни разу сюда не приехав."
    },
    {
      "i": 6,
      "t": 27.408,
      "dur": 1.861,
      "cue": "0.35-0.60 виноградари в междурядьях",
      "text": "Голицын не рыл подвалы."
    },
    {
      "i": 7,
      "t": 30.252,
      "dur": 4.606,
      "cue": null,
      "text": "Он выбирал глубокий овраг, расчищал дно и достраивал свод сверху."
    },
    {
      "i": 8,
      "t": 35.85,
      "dur": 5.231,
      "cue": null,
      "text": "Восемьдесят восьмой, девяносто пятый, девяносто восьмой, девяносто девятый."
    },
    {
      "i": 9,
      "t": 42.032,
      "dur": 2.22,
      "cue": null,
      "text": "Четыре подвала."
    },
    {
      "i": 10,
      "t": 44.902,
      "dur": 4.198,
      "cue": "0.60-0.85 вечер, окна загораются",
      "text": "Осенью тысяча восемьсот девяносто девятого князь приехал впервые."
    },
    {
      "i": 11,
      "t": 50.083,
      "dur": 1.916,
      "cue": null,
      "text": "Он ждал дворец над морем."
    },
    {
      "i": 12,
      "t": 52.923,
      "dur": 5.031,
      "cue": null,
      "text": "Увидел виноградники и погреба — и управляющего прогнал."
    },
    {
      "i": 13,
      "t": 58.604,
      "dur": 3.057,
      "cue": "0.85-1.00 ночь, ласточки уходят",
      "text": "Сто тридцать восемь лет спустя подвалы стоят."
    },
    {
      "i": 14,
      "t": 62.671,
      "dur": 5.433,
      "cue": null,
      "text": "В них по-прежнему четырнадцать градусов — и зимой, и в августе."
    }
  ]
}