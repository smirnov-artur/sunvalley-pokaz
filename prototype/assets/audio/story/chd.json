    {
      "i": 0,
      "t": 0.1,
      "dur": 0.965,
      "cue": "0.00-0.12 ворота 1888, герб со львами",
      "text": "Эким кара."
    },
    {
      "i": 1,
      "t": 1.993,
      "dur": 4.796,
      "cue": null,
      "text": "Крымскотатарское имя чёрной, почти чернильной ягоды: чёрный доктор."
    },
    {
      "i": 2,
      "t": 7.713,
      "dur": 4.407,
      "cue": null,
      "text": "Имя дали ягоде — вино получило его в наследство."
    },
    {
      "i": 3,
      "t": 12.77,
      "dur": 2.717,
      "cue": "0.12-0.35 ленты текут по ступеням",
      "text": "Кто был этот доктор, не знает никто."
    },
    {
      "i": 4,
      "t": 16.497,
      "dur": 2.133,
      "cue": null,
      "text": "В архиве винодельни его нет."
    },
    {
      "i": 5,
      "t": 19.622,
      "dur": 6.344,
      "cue": null,
      "text": "Он есть только на этикетке — и вот здесь, на ступенях, где мы его дорисовали."
    },
    {
      "i": 6,
      "t": 26.616,
      "dur": 5.122,
      "cue": "0.35-0.60 доктор спускается, фонарь качается",
      "text": "Так эту сцену рисуют себе в долине: подвал, фонарь, поздний гость у бочек."
    },
    {
      "i": 7,
      "t": 32.721,
      "dur": 3.443,
      "cue": null,
      "text": "Легенда, а не запись в книге."
    },
    {
      "i": 8,
      "t": 36.814,
      "dur": 1.793,
      "cue": "0.60-0.80 бочки, фигура у бочек",
      "text": "Проверить можно другое."
    },
    {
      "i": 9,
      "t": 39.59,
      "dur": 3.003,
      "cue": null,
      "text": "Эким кара, джеват кара, кефесия."
    },
    {
      "i": 10,
      "t": 43.585,
      "dur": 2.391,
      "cue": null,
      "text": "Лозы старше тридцати пяти лет."
    },
    {
      "i": 11,
      "t": 46.968,
      "dur": 3.402,
      "cue": null,
      "text": "Не меньше трёх лет в дубовой бочке."
    },
    {
      "i": 12,
      "t": 51.02,
      "dur": 6.033,
      "cue": "0.80-1.00 бутылка поднимается и растворяется в карточку",
      "text": "В феврале две тысячи двадцать шестого Роскачество поставило ему девяносто целых восемь десятых балла."
    },
    {
      "i": 13,
      "t": 58.035,
      "dur": 3.342,
      "cue": null,
      "text": "Второй результат среди всех креплёных вин России."
    },
    {
      "i": 14,
      "t": 62.302,
      "dur": 2.538,
      "cue": null,
      "text": "Первый — тоже наш."
    }
  ]
}