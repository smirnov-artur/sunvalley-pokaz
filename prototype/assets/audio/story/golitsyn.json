      "cue": "0.00-0.35 усадьба, лучи",
      "text": "Я искал не красоту."
    },
    {
      "i": 1,
      "t": 2.928,
      "dur": 4.666,
      "cue": null,
      "text": "Я искал сумму температур, камень в почве и отсутствие дождя."
    },
    {
      "i": 2,
      "t": 8.64,
      "dur": 3.546,
      "cue": null,
      "text": "Здесь было всё это — и не было ничего больше."
    },
    {
      "i": 3,
      "t": 13.204,
      "dur": 3.788,
      "cue": null,
      "text": "Ни воды, ни людей, ни дороги."
    },
    {
      "i": 4,
      "t": 17.792,
      "dur": 6.759,
      "cue": "0.35-0.75 подвал, овраг",
      "text": "Там, где рос шиповник, виноградник будет давать хорошие урожаи, а вино будет высокого качества."
    },
    {
      "i": 5,
      "t": 25.591,
      "dur": 3.261,
      "cue": null,
      "text": "Я это говорил и повторю."
    },
    {
      "i": 6,
      "t": 29.652,
      "dur": 1.512,
      "cue": "0.75-1.00 вечер, окна",
      "text": "Подвалы я не рыл."
    },
    {
      "i": 7,
      "t": 32.16,
      "dur": 3.852,
      "cue": null,
      "text": "Я брал овраг, вычищал дно и накрывал сводом."
    },
    {
      "i": 8,
      "t": 37.058,
      "dur": 4.566,
      "cue": null,
      "text": "Через девять лет то же самое я сделаю в Массандре."
