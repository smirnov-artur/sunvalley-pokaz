      "cue": "0.00-0.25 линия начинает рисоваться слева",
      "text": "Одна линия."
    },
    {
      "i": 1,
      "t": 2.36,
      "dur": 1.766,
      "cue": null,
      "text": "Мыс Меганом и море."
    },
    {
      "i": 2,
      "t": 5.091,
      "dur": 4.341,
      "cue": null,
      "text": "Так его рисовали на итальянских картах задолго до нас."
    },
    {
      "i": 3,
      "t": 10.082,
      "dur": 2.187,
      "cue": "0.25-0.60 фигура с собакой идёт по кончику линии",
      "text": "Здесь дождя почти не бывает."
    },
    {
      "i": 4,
      "t": 13.211,
      "dur": 1.861,
      "cue": null,
      "text": "Двести миллиметров в год."
    },
    {
      "i": 5,
      "t": 16.078,
      "dur": 3.216,
      "cue": null,
      "text": "Около трёхсот солнечных дней."
    },
    {
      "i": 6,
      "t": 19.944,
      "dur": 2.269,
      "cue": "0.60-0.85 парусник выходит на воду",
      "text": "Под ногами — глинистый сланец."
    },
    {
      "i": 7,
      "t": 23.128,
      "dur": 3.478,
      "cue": null,
      "text": "Высота — от ста пятидесяти до двухсот метров."
    },
    {
      "i": 8,
      "t": 27.571,
      "dur": 4.993,
      "cue": null,
      "text": "Виноградарство здесь трудное занятие — и в этом весь смысл."
    },
    {
      "i": 9,
      "t": 33.214,
      "dur": 2.351,
      "cue": "0.85-1.00 линия замкнулась, бутылка",
      "text": "Меганом — вино этой линии."
    },
    {
      "i": 10,
      "t": 36.493,
      "dur": 3.749,
      "cue": null,
      "text": "Кефесия, лозы тридцати пяти лет."
