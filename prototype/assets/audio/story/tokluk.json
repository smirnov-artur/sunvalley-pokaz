      "cue": "0.00-0.20 зверь выходит из-за гор справа",
      "text": "Токлукская долина."
    },
    {
      "i": 1,
      "t": 2.455,
      "dur": 2.296,
      "cue": null,
      "text": "Сегодня на карте — Богатовка."
    },
    {
      "i": 2,
      "t": 5.716,
      "dur": 5.996,
      "cue": null,
      "text": "Токлук остался в имени имения, которое купил Горчаков, и на этикетке."
    },
    {
      "i": 3,
      "t": 12.362,
      "dur": 2.242,
      "cue": "0.20-0.50 процессия втягивается на дорогу",
      "text": "Зверя на ней придумал орнамент."
    },
    {
      "i": 4,
      "t": 15.532,
      "dur": 4.552,
      "cue": null,
      "text": "Шахматная спина, красный глаз — он не из легенды, он из узора."
    },
    {
      "i": 5,
      "t": 21.062,
      "dur": 3.008,
      "cue": null,
      "text": "Мы просто дали ему дорогу."
    },
    {
      "i": 6,
      "t": 24.72,
      "dur": 6.128,
      "cue": "0.50-0.80 корзины и кувшины, фигуры крупнее",
      "text": "За ним — те, кто ходил этой дорогой на самом деле: с корзинами вверх, с кувшинами вниз."
    },
    {
      "i": 7,
      "t": 31.776,
      "dur": 4.988,
      "cue": null,
      "text": "Виноградники здесь размечали ещё в тысяча восемьсот четвёртом."
    },
    {
      "i": 8,
      "t": 37.414,
      "dur": 2.785,
      "cue": "0.80-1.00 процессия уходит влево, солнце-орнамент",
      "text": "Токлук — самая молодая линейка долины."
    },
    {
      "i": 9,
      "t": 41.196,
      "dur": 4.28,
      "cue": null,
      "text": "Сухие вина: верментино, монтепульчано, каберне фран."
    },
    {
      "i": 10,
      "t": 46.427,
      "dur": 3.367,
      "cue": null,
      "text": "Старая земля учит новые сорта."
    }
  ]
